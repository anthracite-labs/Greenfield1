
# Human-readable project name. Empty in the template; set by
# scripts/init-project.sh or by hand in the first product issue.
PROJECT_NAME=App1

# Short slug used in generated text. Empty in the template.
PROJECT_SLUG=app1

# Lifecycle phase. One of:
#   factory        this is the App-Factory template itself, not an application
#   discovery      product definition is being discovered and refined; approved working requirements may exist
#   architecture   product definition is accepted enough to choose implementation approaches via ADR
#   implementation stack chosen and recorded in an ADR; application code allowed
PROJECT_PHASE=discovery

# Foundation no-stack guard. 0 = reject application-stack artifacts,
# 1 = the guard stands down.
#
# Setting this to 1 is a deliberate, reviewed transition. verify.sh requires
# ALL of the following before it will accept 1:
#   - PROJECT_PHASE=implementation
#   - STACK_DECISION_ADR points at an existing file under docs/decisions/
#   - that file is NOT the 0000-template.md skeleton
#   - that file contains the line: **Decision Type:** application-stack
#   - that file contains the line: **Status:** accepted
# Pointing at an unrelated or still-proposed ADR is rejected: existing on disk
# is not the same as recording an approved stack decision.
# The guard standing down only means the FOUNDATION check no longer rejects
# stack artifacts. Stack-specific lint/test/build gates are a separate, later
# addition.
ALLOW_APP_STACK=0

# Relative path to the ADR that records the implementation stack decision.
# Empty until that decision exists. Example: docs/decisions/0005-stack.md
# The ADR must be marked "**Decision Type:** application-stack" and be
# accepted; see docs/FACTORY.md.
STACK_DECISION_ADR=
